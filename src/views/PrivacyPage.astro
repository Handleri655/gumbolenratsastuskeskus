---
import PageHero from '../components/PageHero.astro';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<PageHero eyebrow={dict.privacy.eyebrow} title={dict.privacy.title} lede={dict.privacy.lede} />
<div class="mx-auto max-w-3xl space-y-10 px-5 py-16 md:py-24">
  {
    dict.privacy.sections.map((section) => (
      <section>
        <h2 class="font-serif text-3xl text-forest-900">{section.heading}</h2>
        <p class="mt-3 leading-relaxed text-muted">{section.body}</p>
      </section>
    ))
  }
</div>
