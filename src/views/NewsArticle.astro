---
import { getCollection, render } from 'astro:content';
import type { Dict } from '../i18n';
import { formatDate, pathFor, type Lang } from '../lib/routes';

interface Props {
  id: string;
  lang: Lang;
  dict: Dict;
}

const { id, lang, dict } = Astro.props;
const entry = (await getCollection('news')).find((item) => item.id === id);
if (!entry) {
  throw new Error(`News entry missing: ${id}`);
}
const { Content } = await render(entry);
---

<article class="mx-auto max-w-3xl px-5 py-16 md:py-24">
  <p class="text-sm text-muted">
    <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date, lang)}</time>
    {' · '}
    {entry.data.tags.map((tag) => dict.tags[tag]).join(' · ')}
  </p>
  <h1 class="mt-4 font-serif text-5xl leading-tight text-forest-900">{entry.data.title}</h1>
  <p class="mt-5 text-lg text-muted">{entry.data.description}</p>
  <div class="prose mt-8 text-lg leading-relaxed text-ink">
    <Content />
  </div>
  <p class="mt-12">
    <a class="text-sm font-semibold text-forest-900 underline decoration-ochre-400 underline-offset-4" href={pathFor(lang, 'ajankohtaista')}>
      {dict.actions.backNews}
    </a>
  </p>
</article>
