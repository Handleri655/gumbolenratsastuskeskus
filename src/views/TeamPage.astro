---
import { site } from '../config/site';
import PageHero from '../components/PageHero.astro';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const page = dict.team;

function initial(name: string) {
  return name.slice(0, 1);
}
---

<PageHero eyebrow={page.eyebrow} title={page.title} lede={page.lede} />

<div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
  <article class="border-t-2 border-ochre-400 bg-cream-50 p-6 md:p-8">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">{dict.footer.managerRole}</p>
    <h2 class="mt-2 font-serif text-4xl text-forest-900">{site.manager}</h2>
    <p class="mt-4">
      <a class="font-semibold text-forest-900 underline decoration-ochre-400 underline-offset-4" href={`tel:${site.phones.manager.tel}`}>
        {site.phones.manager.display}
      </a>
    </p>
    <p class="mt-2">
      <a class="text-forest-900 underline decoration-ochre-400 underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </article>

  <h2 class="mt-14 font-serif text-3xl text-forest-900">{page.permanent}</h2>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      site.staff.permanent.map((name) => (
        <li class="border border-forest-900/10 bg-cream-50 px-5 py-6">
          <span class="flex h-12 w-12 items-center justify-center bg-forest-900 font-serif text-2xl text-cream-50" aria-hidden="true">
            {initial(name)}
          </span>
          <p class="mt-4 font-serif text-3xl text-forest-900">{name}</p>
        </li>
      ))
    }
  </ul>

  <h2 class="mt-14 font-serif text-3xl text-forest-900">{page.hourly}</h2>
  <p class="mt-3 text-muted">{page.hourlyNote}</p>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      site.staff.hourly.map((name) => (
        <li class="border border-forest-900/10 bg-cream-50 px-5 py-6">
          <span class="flex h-12 w-12 items-center justify-center bg-ochre-400 font-serif text-2xl text-forest-950" aria-hidden="true">
            {initial(name)}
          </span>
          <p class="mt-4 font-serif text-3xl text-forest-900">{name}</p>
        </li>
      ))
    }
  </ul>

  <p class="mt-12 text-muted">{page.contactCta}</p>
</div>
