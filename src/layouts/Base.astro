---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-ext-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-ext-600.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-ext-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-ext-600.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import { getDict } from '../i18n';
import AlertBanner from '../components/AlertBanner.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileBar from '../components/MobileBar.astro';
import { pathFor, type Lang, type PageId } from '../lib/routes';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  current: PageId | 'uutinen';
  alternates: Record<Lang, string>;
  noindex?: boolean;
}

const { lang, title, description, current, alternates, noindex = false } = Astro.props;
const dict = getDict(lang);
const origin = Astro.site ?? new URL(site.url);
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(canonicalPath, origin).toString();
const ogImage = new URL('/og.jpg', origin).toString();
const locale = lang === 'sv' ? 'sv_FI' : lang === 'en' ? 'en_GB' : 'fi_FI';

const alert = (await getCollection('news'))
  .filter((entry) => entry.data.lang === lang && entry.data.alert)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['SportsActivityLocation', 'LocalBusiness'],
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  image: ogImage,
  telephone: site.phones.manager.tel,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  identifier: [
    { '@type': 'PropertyValue', name: 'Y-tunnus', value: site.businessId },
    { '@type': 'PropertyValue', name: 'Pitopaikkatunnus', value: site.holdingPlaceId },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1f3a2e" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      (['fi', 'sv', 'en'] as const).map((code) => (
        <link rel="alternate" hreflang={code} href={new URL(alternates[code], origin).toString()} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.fi, origin).toString()} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body class="pb-16 md:pb-0">
    <a href="#sisalto" class="skip-link">{dict.a11y.skip}</a>
    {
      alert && (
        <AlertBanner
          label={dict.news.alertLabel}
          title={alert.data.title}
          href={pathFor(lang, 'ajankohtaista', alert.data.slug)}
          readMore={dict.actions.readMore}
        />
      )
    }
    <Header lang={lang} dict={dict} current={current} alternates={alternates} />
    <main id="sisalto">
      <slot />
    </main>
    <Footer lang={lang} dict={dict} />
    <MobileBar dict={dict} />
  </body>
</html>
