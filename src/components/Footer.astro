---
import { site } from '../config/site';
import type { Dict } from '../i18n';
import { pathFor, type Lang, type PageId } from '../lib/routes';

interface Props {
  lang: Lang;
  dict: Dict;
}

const { lang, dict } = Astro.props;
const links: { page: PageId; label: string }[] = [
  { page: 'talli', label: dict.nav.stable },
  { page: 'palvelut', label: dict.nav.services },
  { page: 'vuokraus', label: dict.nav.rental },
  { page: 'valmennus', label: dict.nav.training },
  { page: 'jasenille', label: dict.nav.members },
  { page: 'historia', label: dict.nav.history },
  { page: 'henkilokunta', label: dict.actions.staffPage },
  { page: 'ajankohtaista', label: dict.nav.news },
  { page: 'yhteystiedot', label: dict.nav.contact },
  { page: 'tietosuoja', label: dict.footer.privacy },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-forest-900/10 bg-forest-950 text-cream-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-4">
    <div class="md:col-span-1">
      <p class="font-serif text-3xl text-cream-50">Gumböle</p>
      <p class="mt-3 text-sm leading-relaxed text-cream-200">{dict.footer.blurb}</p>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-ochre-400">{dict.footer.visit}</h2>
      <p class="mt-3 text-sm leading-relaxed">
        {site.legalName}<br />
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city}
      </p>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-ochre-400">{dict.footer.contact}</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          {dict.footer.managerRole}<br />
          {site.manager}<br />
          <a class="underline decoration-ochre-400/70 underline-offset-4" href={`tel:${site.phones.manager.tel}`}>{site.phones.manager.display}</a>
        </li>
        <li>
          <a class="underline decoration-ochre-400/70 underline-offset-4" href={`tel:${site.phones.staff.tel}`}>{site.phones.staff.display}</a><br />
          <span class="text-cream-200">{dict.footer.staffHours}</span>
        </li>
        <li>
          <a class="underline decoration-ochre-400/70 underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-ochre-400">{dict.footer.links}</h2>
      <ul class="mt-3 columns-2 gap-6 text-sm">
        {
          links.map((link) => (
            <li class="mb-2">
              <a class="hover:text-cream-50" href={pathFor(lang, link.page)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-cream-50/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 text-xs text-cream-200 sm:flex-row sm:justify-between">
      <p>© {year} {site.legalName}</p>
      <p>
        {dict.contact.businessId} {site.businessId}
        <span aria-hidden="true"> · </span>
        {dict.contact.holdingId} {site.holdingPlaceId}
      </p>
    </div>
  </div>
</footer>
