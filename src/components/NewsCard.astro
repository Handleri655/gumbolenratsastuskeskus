---
interface Props {
  href: string;
  title: string;
  description: string;
  date: string;
  tags: string[];
  readMore: string;
}

const { href, title, description, date, tags, readMore } = Astro.props;
---

<article class="flex h-full flex-col border-t-2 border-ochre-400 bg-cream-50 p-6">
  <p class="text-sm text-muted">
    <time>{date}</time>
    {
      tags.length > 0 && (
        <span>
          {' · '}
          {tags.join(' · ')}
        </span>
      )
    }
  </p>
  <h3 class="mt-3 font-serif text-3xl leading-tight text-forest-900">
    <a href={href} class="hover:underline">{title}</a>
  </h3>
  <p class="mt-3 flex-1 leading-relaxed text-muted">{description}</p>
  <a href={href} class="mt-5 text-sm font-semibold text-forest-900 underline decoration-ochre-400 underline-offset-4">
    {readMore}
  </a>
</article>
