---
interface Item {
  year: string;
  title: string;
  text: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ol class="border-l border-ochre-400/80">
  {
    items.map((item) => (
      <li class="relative pb-10 pl-8 last:pb-0">
        <span class="absolute top-2 -left-[7px] h-3.5 w-3.5 rounded-full bg-forest-900 ring-4 ring-cream-100" aria-hidden="true" />
        <p class="font-serif text-4xl leading-none text-forest-900">{item.year}</p>
        <h3 class="mt-2 text-lg font-semibold text-ink">{item.title}</h3>
        <p class="mt-2 max-w-2xl leading-relaxed text-muted">{item.text}</p>
      </li>
    ))
  }
</ol>
