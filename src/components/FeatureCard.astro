---
interface Props {
  index: string;
  title: string;
  text: string;
  href?: string;
  linkLabel?: string;
}

const { index, title, text, href, linkLabel } = Astro.props;
---

<article class="border-t-2 border-ochre-400 bg-cream-50 px-6 py-8">
  <p class="font-serif text-3xl text-ochre-700">{index}</p>
  <h3 class="mt-3 font-serif text-3xl leading-tight text-forest-900">{title}</h3>
  <p class="mt-3 leading-relaxed text-muted">{text}</p>
  {
    href && linkLabel && (
      <a class="mt-4 inline-flex text-sm font-semibold text-forest-900 underline decoration-ochre-400 underline-offset-4" href={href}>
        {linkLabel}
      </a>
    )
  }
</article>
