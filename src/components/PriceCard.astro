---
interface Props {
  title: string;
  price: string;
  unit: string;
}

const { title, price, unit } = Astro.props;
---

<article class="flex flex-col border border-forest-900/15 bg-cream-50 px-6 py-7">
  <h3 class="font-serif text-3xl text-forest-900">{title}</h3>
  <p class="mt-5 font-serif text-5xl text-forest-900">{price}</p>
  <p class="mt-1 text-sm text-muted">{unit}</p>
</article>
