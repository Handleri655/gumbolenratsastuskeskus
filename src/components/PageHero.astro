---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="border-b border-forest-900/10">
  <div class="mx-auto max-w-6xl px-5 py-14 md:py-20">
    <Eyebrow text={eyebrow} />
    <h1 class="mt-4 max-w-3xl font-serif text-5xl leading-[1.05] text-forest-900 md:text-6xl">{title}</h1>
    {lede && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{lede}</p>}
  </div>
</header>
